{
  "name": "afterhours",
  "version": "0.0.1",
  "private": true,
  "description": "Estúdio desktop de live coding: tracks em Strudel, mixer visual e arranjo por cenas.",
  "license": "AGPL-3.0-only",
  "author": "Pedro Sant'Anna",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "prestart": "vite build",
    "start": "electron .",
    "package": "vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "acorn": "8.19.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "8.2.2",
    "cross-env": "7.0.3",
    "electron": "45.1.0",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12",
    "wait-on": "7.2.0"
  },
  "productName": "Afterhours",
  "build": {
    "appId": "dev.pedro.afterhours",
    "productName": "Afterhours",
    "artifactName": "Afterhours-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
